<Window x:Class="ModSyncLauncher.InstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建实例" Width="440" Height="300"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3FAF7"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Foreground="#15362C">
    <Border Background="#F3FAF7" BorderBrush="#D8ECE4" BorderThickness="1" CornerRadius="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="新建实例" FontSize="19" FontWeight="SemiBold"/>
                <Button Content="×" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent"
                        BorderThickness="0" FontSize="16" Foreground="#6A7F76" Cursor="Hand" Click="Cancel_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="实例名称" FontSize="11" Foreground="#758981"/>
                <TextBox x:Name="NameBox" Height="36" Margin="0,6,0,0" Padding="10,6"
                         VerticalContentAlignment="Center" FontSize="13"/>
                <TextBlock Text="Minecraft 版本" FontSize="11" Foreground="#758981" Margin="0,14,0,0"/>
                <ComboBox x:Name="VersionBox" Height="36" Margin="0,6,0,0" FontSize="13"/>
                <TextBlock Text="模组加载器" FontSize="11" Foreground="#758981" Margin="0,14,0,0"/>
                <ComboBox x:Name="LoaderBox" Height="36" Margin="0,6,0,0" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem Content="NeoForge"/>
                    <ComboBoxItem Content="Fabric"/>
                    <ComboBoxItem Content="Forge"/>
                </ComboBox>
                <TextBlock Text="同一个版本可以创建多个实例，模组互不影响。"
                           FontSize="10.5" Foreground="#758981" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Padding="16,8" Background="Transparent" BorderThickness="0"
                        Foreground="#758981" Cursor="Hand" Click="Cancel_Click"/>
                <Button Content="创建" Padding="18,8" Margin="8,0,0,0" Background="#2FBE9D" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="Create_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
