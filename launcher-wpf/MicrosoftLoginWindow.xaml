<Window x:Class="ModSyncLauncher.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微软登录" Width="500" Height="360"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3FAF7"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Foreground="#15362C">
    <Border Background="#F3FAF7" BorderBrush="#D8ECE4" BorderThickness="1" CornerRadius="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="微软登录" FontSize="19" FontWeight="SemiBold"/>
                <Button Content="×" Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent"
                        BorderThickness="0" FontSize="16" Foreground="#6A7F76" Cursor="Hand" Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock x:Name="StatusText" Text="正在获取登录代码…" FontSize="12" Foreground="#758981"/>
                <Border Background="White" BorderBrush="#D8ECE4" BorderThickness="1" CornerRadius="14" Padding="18,14"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="在浏览器打开" FontSize="10.5" Foreground="#758981"/>
                        <TextBlock x:Name="LinkText" Text="https://www.microsoft.com/link" FontSize="12"
                                   Foreground="#17886C" Margin="0,4,0,0"/>
                        <TextBlock Text="输入代码" FontSize="10.5" Foreground="#758981" Margin="0,14,0,0"/>
                        <TextBlock x:Name="CodeText" Text="————" FontSize="30" FontWeight="Bold"
                                   Foreground="#15362C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="登录完成后，这个窗口会自动关闭。" FontSize="10.5" Foreground="#758981" Margin="0,12,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="打开登录页面" Padding="16,8" Background="#E4F8F1" Foreground="#17886C" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="OpenLink_Click"/>
                <Button Content="取消" Padding="16,8" Margin="8,0,0,0" Background="Transparent" BorderThickness="0"
                        Foreground="#758981" Cursor="Hand" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
